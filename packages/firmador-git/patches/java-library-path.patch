+    static String findPkcs11LibInPath(String libraryPath, String separator, String... names) {
+        if (libraryPath == null) return null;
+        for (String directory : libraryPath.split(java.util.regex.Pattern.quote(separator), -1)) {
+            File parent = new File(directory.isEmpty() ? "." : directory);
+            for (String name : names) {
+                File library = new File(parent, name);
+                if (library.isFile() && library.canRead()) return library.getAbsolutePath();
+            }
+        }
+        return null;
+    }
 
