+/*
+ * Some cards using the "ChipDoc Generic" applet (e.g. the BCCR cards) do not
+ * use PACE. Instead, their file system is protected by Chip Authentication
+ * (BSI TR-03110): the static public key of the card is stored in the file
+ * D004 of the applet and the terminal sends an ephemeral public key during
+ * CA step 2 (GENERAL AUTHENTICATE). The applet answers with an empty
+ * response - neither a nonce nor an authentication token - so the session
+ * keys are derived from the ECDH shared secret alone (which is equivalent to
+ * a nonce of all zeroes in the key derivation function of OpenPACE).
+ */
+
+/* Card Authentication public key: ECDH, AES-CBC, CMAC-128 */
+#define EOI_CHIPDOC_CA_STD_DP 18 /* index of secp521r1 in OpenPACE */
+
+static const u8 eoi_chipdoc_aid[] = {
+	0xE8, 0x28, 0xBD, 0x08, 0x0F, 0xA0, 0x00, 0x00, 0x03, 0x63, 0x64, 0x79, 0x6E, 0x69, 0x64
+};
+
+static const u8 eoi_chipdoc_mse_data[] = {
+	0x80, 0x0A, 0x04, 0x00, 0x7F, 0x00, 0x07, 0x02, 0x02, 0x03, 0x02, 0x02
+};
+
+static int eoi_chipdoc_transmit(struct sc_card *card, u8 cla, u8 ins, u8 p1, u8 p2,
+		const u8 *data, size_t data_len)
+{
+	struct sc_apdu apdu;
+	int r;
+
+	sc_format_apdu(card, &apdu, SC_APDU_CASE_3_SHORT, ins, p1, p2);
+	apdu.cla = cla;
+	apdu.lc = data_len;
+	apdu.datalen = data_len;
+	apdu.data = data;
+
+	r = sc_transmit_apdu(card, &apdu);
+	LOG_TEST_RET(card->ctx, r, "APDU transmit failed");
+	return sc_check_sw(card, apdu.sw1, apdu.sw2);
+}
+
+/*
+ * Read the static public key of the card from EF(D004). The file contains a
+ * 5 byte header followed by the length and the uncompressed public point.
+ */
+static int eoi_chipdoc_read_ca_pubkey(struct sc_card *card, u8 **pubkey, size_t *pubkey_len)
+{
+	static const u8 ef_d004[] = {0xD0, 0x04};
+	struct sc_apdu apdu;
+	u8 buf[256];
+	u8 *key;
+	size_t point_len;
+	int r;
+
+	*pubkey = NULL;
+	*pubkey_len = 0;
+
+	/* The file system of the applet is not accessible from MF */
+	r = sc_select_file(card, sc_get_mf_path(), NULL);
+	LOG_TEST_RET(card->ctx, r, "Cannot select MF");
+
+	r = eoi_chipdoc_transmit(card, 0x00, 0xA4, 0x04, 0x0C, eoi_chipdoc_aid, sizeof eoi_chipdoc_aid);
+	LOG_TEST_RET(card->ctx, r, "Cannot select the ChipDoc applet");
+
+	r = eoi_chipdoc_transmit(card, 0x00, 0xA4, 0x02, 0x00, ef_d004, sizeof ef_d004);
+	LOG_TEST_RET(card->ctx, r, "Cannot select EF(Chip Authentication public key)");
+
+	sc_format_apdu(card, &apdu, SC_APDU_CASE_2_SHORT, 0xB0, 0x00, 0x00);
+	apdu.resp = buf;
+	apdu.resplen = sizeof buf;
+	apdu.le = 137;
+
+	r = sc_transmit_apdu(card, &apdu);
+	LOG_TEST_RET(card->ctx, r, "APDU transmit failed");
+	r = sc_check_sw(card, apdu.sw1, apdu.sw2);
+	LOG_TEST_RET(card->ctx, r, "Cannot read EF(Chip Authentication public key)");
+
+	if (apdu.resplen < 6 || buf[0] != 0x00 || buf[1] != 0x01) {
+		sc_log(card->ctx, "Unexpected content of EF(Chip Authentication public key)");
+		LOG_FUNC_RETURN(card->ctx, SC_ERROR_UNKNOWN_DATA_RECEIVED);
+	}
+	point_len = buf[4];
+	if (point_len < 3 || apdu.resplen < 5 + point_len) {
+		sc_log(card->ctx, "Unexpected length of the Chip Authentication public key");
+		LOG_FUNC_RETURN(card->ctx, SC_ERROR_UNKNOWN_DATA_RECEIVED);
+	}
+
+	key = malloc(1 + point_len);
+	if (!key)
+		LOG_FUNC_RETURN(card->ctx, SC_ERROR_OUT_OF_MEMORY);
+	key[0] = 0x04;
+	memcpy(key + 1, buf + 5, point_len);
+
+	*pubkey = key;
+	*pubkey_len = 1 + point_len;
+	return SC_SUCCESS;
+}
+
+/*
+ * Read the serial number of the card from EF(D003). The file contains the
+ * serial number in a "5A" TLV; like the vendor middleware, use its last 8
+ * bytes. The file is not part of the file system of the applet, so it is
+ * selected via the MF; the applet is selected again afterwards, as selecting
+ * the MF makes the file system of the applet unavailable.
+ */
+static int eoi_chipdoc_get_serialnr(struct sc_card *card, struct sc_serial_number *serial)
+{
+	static const u8 ef_d003[] = {0xD0, 0x03};
+	struct sc_apdu apdu;
+	u8 buf[16];
+	size_t len, offs;
+	int r;
+
+	if (card->serialnr.len)
+		goto end;
+
+	/* The EF is selected like the vendor middleware does; the files of
+	 * the applet are addressed by their file ID */
+	r = sc_select_file(card, sc_get_mf_path(), NULL);
+	LOG_TEST_RET(card->ctx, r, "Cannot select MF");
+
+	r = eoi_chipdoc_transmit(card, 0x00, 0xA4, 0x02, 0x00, ef_d003, sizeof ef_d003);
+	LOG_TEST_RET(card->ctx, r, "Cannot select EF(serial number)");
+
+	sc_format_apdu(card, &apdu, SC_APDU_CASE_2_SHORT, 0xB0, 0x00, 0x00);
+	apdu.resp = buf;
+	apdu.resplen = sizeof buf;
+	apdu.le = 0x0C;
+
+	r = sc_transmit_apdu(card, &apdu);
+	LOG_TEST_RET(card->ctx, r, "APDU transmit failed");
+	r = sc_check_sw(card, apdu.sw1, apdu.sw2);
+	LOG_TEST_RET(card->ctx, r, "Cannot read EF(serial number)");
+
+	/* Selecting the MF made the file system of the applet unavailable;
+	 * select the applet again, so that the caller can keep using it */
+	r = eoi_chipdoc_transmit(card, 0x00, 0xA4, 0x04, 0x0C, eoi_chipdoc_aid, sizeof eoi_chipdoc_aid);
+	LOG_TEST_RET(card->ctx, r, "Cannot select the ChipDoc applet");
+
+	if (apdu.resplen < 2 || buf[0] != 0x5A || buf[1] > apdu.resplen - 2)
+		LOG_FUNC_RETURN(card->ctx, SC_ERROR_UNKNOWN_DATA_RECEIVED);
+
+	/* Copy the serial number from the last 8 bytes (at most) */
+	len = buf[1];
+	offs = len > 8 ? len - 8 : 0;
+	memcpy(card->serialnr.value, buf + 2 + offs, len - offs);
+	card->serialnr.len = len - offs;
+
+end:
+	if (serial)
+		memcpy(serial, &card->serialnr, sizeof(*serial));
+
+	return SC_SUCCESS;
+}
+
+/* Send the ephemeral public key of the terminal (CA step 2) */
+static int eoi_chipdoc_gen_auth(struct sc_card *card, const BUF_MEM *pubkey)
+{
+	u8 *data;
+	size_t data_len;
+	int r;
+
+	if (!pubkey || pubkey->length < 3 || pubkey->length > 0xFF - 3)
+		return SC_ERROR_INVALID_ARGUMENTS;
+
+	/* Dynamic Authentication Data: 7C ::= { 80 ::= ephemeral public key } */
+	data_len = 6 + pubkey->length;
+	data = malloc(data_len);
+	if (!data)
+		return SC_ERROR_OUT_OF_MEMORY;
+	data[0] = 0x7C;
+	data[1] = 0x81;
+	data[2] = (u8)(3 + pubkey->length);
+	data[3] = 0x80;
+	data[4] = 0x81;
+	data[5] = (u8)pubkey->length;
+	memcpy(data + 6, pubkey->data, pubkey->length);
+
+	/* The applet expects the secure messaging indicator in the class byte */
+	r = eoi_chipdoc_transmit(card, 0x10, 0x86, 0x00, 0x00, data, data_len);
+	free(data);
+
+	if (r != SC_SUCCESS) {
+		sc_log(card->ctx, "GENERAL AUTHENTICATE failed: %s", sc_strerror(r));
+		return r;
+	}
+	return SC_SUCCESS;
+}
+
+/* Establish secure messaging using Chip Authentication */
+static int eoi_chipdoc_sm_open(struct sc_card *card)
+{
+	EAC_CTX *eac_ctx = NULL;
+	BUF_MEM *picc_pubkey_buf = NULL, *eph_pubkey = NULL, *comp_pubkey = NULL;
+	u8 *picc_pubkey = NULL;
+	size_t picc_pubkey_len = 0;
+	int r;
+
+	LOG_FUNC_CALLED(card->ctx);
+
+	/* Read the static public key of the card */
+	r = eoi_chipdoc_read_ca_pubkey(card, &picc_pubkey, &picc_pubkey_len);
+	LOG_TEST_GOTO_ERR(card->ctx, r, "Cannot read the Chip Authentication public key");
+
+	picc_pubkey_buf = BUF_MEM_create_init(picc_pubkey, picc_pubkey_len);
+	if (!picc_pubkey_buf)
+		LOG_TEST_GOTO_ERR(card->ctx, SC_ERROR_OUT_OF_MEMORY, "Out of memory");
+
+	EAC_init();
+	eac_ctx = EAC_CTX_new();
+	if (!eac_ctx)
+		LOG_TEST_GOTO_ERR(card->ctx, SC_ERROR_OUT_OF_MEMORY, "Out of memory");
+	eac_ctx->tr_version = EAC_TR_VERSION_2_02;
+
+	if (!EAC_CTX_init_ca(eac_ctx, NID_id_CA_ECDH_AES_CBC_CMAC_128, EOI_CHIPDOC_CA_STD_DP))
+		LOG_TEST_GOTO_ERR(card->ctx, SC_ERROR_INTERNAL, "Cannot initialize Chip Authentication");
+
+	/* Tell the card which protocol to use */
+	r = eoi_chipdoc_transmit(card, 0x00, 0x22, 0x41, 0xA4,
+			eoi_chipdoc_mse_data, sizeof eoi_chipdoc_mse_data);
+	LOG_TEST_GOTO_ERR(card->ctx, r, "Cannot set the authentication template");
+
+	/* Generate the ephemeral key pair. (The function used for TA step 3
+	 * only generates the key pair and returns its compressed encoding.) */
+	comp_pubkey = TA_STEP3_generate_ephemeral_key(eac_ctx);
+	if (!comp_pubkey)
+		LOG_TEST_GOTO_ERR(card->ctx, SC_ERROR_INTERNAL, "Cannot generate ephemeral key");
+
+	eph_pubkey = CA_STEP2_get_eph_pubkey(eac_ctx);
+	if (!eph_pubkey)
+		LOG_TEST_GOTO_ERR(card->ctx, SC_ERROR_INTERNAL, "Cannot get ephemeral public key");
+
+	/* CA step 2 */
+	r = eoi_chipdoc_gen_auth(card, eph_pubkey);
+	LOG_TEST_GOTO_ERR(card->ctx, r, "Cannot send ephemeral public key");
+
+	/* CA step 3: ECDH with the static public key of the card */
+	if (!CA_STEP4_compute_shared_secret(eac_ctx, picc_pubkey_buf))
+		LOG_TEST_GOTO_ERR(card->ctx, SC_ERROR_INTERNAL, "Cannot compute shared secret");
+
+	/* The card returns neither a nonce nor an authentication token, so the
+	 * session keys are derived from the shared secret alone */
+	if (!KA_CTX_derive_keys(eac_ctx->ca_ctx->ka_ctx, NULL, eac_ctx->md_ctx))
+		LOG_TEST_GOTO_ERR(card->ctx, SC_ERROR_INTERNAL, "Cannot derive session keys");
+
+	if (!EAC_CTX_set_encryption_ctx(eac_ctx, EAC_ID_CA))
+		LOG_TEST_GOTO_ERR(card->ctx, SC_ERROR_INTERNAL, "Cannot set encryption context");
+
+	/* Start secure messaging; on success the SM layer owns the EAC context */
+	r = eac_sm_start(card, eac_ctx, NULL, 0);
+	if (r == SC_SUCCESS)
+		eac_ctx = NULL;
+	LOG_TEST_GOTO_ERR(card->ctx, r, "Cannot start secure messaging");
+
+	/* Synchronize the SM channel like the vendor middleware: the first SM
+	 * protected command is a SELECT MF */
+	r = sc_select_file(card, sc_get_mf_path(), NULL);
+	LOG_TEST_GOTO_ERR(card->ctx, r, "Cannot select MF");
+
+	r = SC_SUCCESS;
+
+err:
+	BUF_MEM_clear_free(picc_pubkey_buf);
+	BUF_MEM_clear_free(eph_pubkey);
+	BUF_MEM_clear_free(comp_pubkey);
+	if (eac_ctx)
+		EAC_CTX_clear_free(eac_ctx);
+	if (picc_pubkey) {
+		sc_mem_clear(picc_pubkey, picc_pubkey_len);
+		free(picc_pubkey);
+	}
+
+	LOG_FUNC_RETURN(card->ctx, r);
+}
